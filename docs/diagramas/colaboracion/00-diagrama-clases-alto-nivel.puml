VideoAnalysisController ..> Video : <<use>>
VideoAnalysisController ..> PoseResultado : <<use>>
AnalisisMovimientoController ..> Gimnasta : <<use>>
AnalisisMovimientoController ..> AptitudMedica : <<use>>
AnalisisMovimientoController ..> EvaluacionNutricional : <<use>>
AnalisisMovimientoController ..> EvaluacionPsicologica : <<use>>
AnalisisMovimientoController ..> EvaluacionFisiologica : <<use>>
AnalisisMovimientoController ..> EvaluacionRespiratoria : <<use>>
