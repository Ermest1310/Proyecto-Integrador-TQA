' ==================== RELACIONES ====================

' --- Herencia ---
Gimnasta -|> Usuario : "extends"

' --- Asociaciones Core ---
Usuario "1" --> "1" Rol : tiene
Usuario "1" --> "*" Lesion : "registra como médico"
Usuario "1" --> "*" Lesion : "sufre como gimnasta"
Usuario "1" --> "*" SesionEntrenamiento : "participa como gimnasta"
Usuario "1" --> "*" SesionEntrenamiento : "supervisa como entrenador"
Usuario "1" --> "*" EvaluacionesJuez : "evalúa como juez"
Usuario "1" --> "*" EvaluacionesJuez : "es evaluado como gimnasta"
Usuario "1" --> "*" Postulacion : revisa
Usuario "1" --> "*" SolicitudNivel : recomienda como entrenador
Usuario "1" --> "*" SolicitudNivel : solicita como gimnasta
Usuario "1" --> "*" Video : sube

' --- Aparato ---
SesionEntrenamiento "*" --> "1" Aparato : utiliza
Entrenamiento "*" --> "1" Aparato : utiliza
EvaluacionesJuez "*" --> "1" Aparato : corresponde
DeduccionEjecucion "*" --> "1" Aparato : define reglas

' --- Evaluaciones Médicas ---
Gimnasta "1" --> "*" AptitudMedica : posee
Gimnasta "1" --> "*" EvaluacionNutricional : posee
Gimnasta "1" --> "*" EvaluacionPsicologica : posee
Gimnasta "1" --> "*" EvaluacionFisiologica : posee
Gimnasta "1" --> "*" EvaluacionRespiratoria : posee

' --- Jueces ---
EvaluacionesJuez "1" --> "*" DescuentosJuez : contiene
EvaluacionesJuez "1" --> "*" VideosEvaluacion : contiene
EvaluacionesJuez "*" --> "1" Competencia : pertenece

' --- Video ---
Video "1" --> "*" PoseResultado : genera

' --- Postulacion/Nivel ---
SolicitudNivel "*" --> "1" Gimnasta : afecta

' --- Controladores usan Modelos ---
